# Copy to .env and adjust: the build and play scripts read it (env.sh). Windows paths, in single quotes.
# The original Lands of Lore: The Throne of Chaos game files (the GOG folder, with GAME.DAT). play.sh and the
# test tools import it into GameData the first time.
LOL_GAME_DIR='C:\GOG Games\Lands of Lore - The Throne of Chaos'
# The Unity editor (default: the project's version under C:\Program Files\Unity\Hub\Editor or C:\Program Files\Unity <version>)
#UNITY='C:\Program Files\Unity\Hub\Editor\6000.6.3f1\Editor\Unity.exe'
