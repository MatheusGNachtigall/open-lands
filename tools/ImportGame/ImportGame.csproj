<Project Sdk="Microsoft.NET.Sdk">
  <!-- The setup page's import (Assets/Scripts/Host/ImportGame.cs) from the command line: env.sh runs it to extract
       the game named by LOL_GAME_DIR (.env) into GameData. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Host/ImportGame.cs" />
  </ItemGroup>
</Project>
